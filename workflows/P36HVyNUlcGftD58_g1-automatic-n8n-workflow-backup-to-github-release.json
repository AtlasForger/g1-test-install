    {
      "parameters": {
        "jsCode": "const dossier = $('CONFIGURATION').first().json.backupFolder;\n\nconst slug = (s) => String(s || 'sans-nom')\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')\n  .slice(0, 60) || 'sans-nom';\n\nreturn $input.all().map(item => {\n  // On retire pinData (données de test, parfois réelles) avant la sauvegarde\n  const { pinData, ...wf } = item.json;\n  return {\n    json: {\n      id: wf.id,\n      name: wf.name,\n      path: `${dossier}/${wf.id}_${slug(wf.name)}.json`,\n      content: JSON.stringify(wf, null, 2),\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "id": "ffe13293-f784-4fe6-9d2a-9b8d7a94e81e",
